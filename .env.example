POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DATABASE


# ВАРИАНТ 1: ОБЛАКО (Supabase) — использовать, если работаете с общей базой
# DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>?ssl=require


# ВАРИАНТ 2: ЛОКАЛЬНО (через Docker / Postgres на ПК)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DATABASE

JWT_SECRET=YOUR_JWT_TOKEN
GROQ_API_KEY=YOUR_GROQ_TOKEN
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
LLM_MODEL=gemini-3.5-flash-lite
OFFICE_TIMEZONE=Europe/Chisinau
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# CORS: allowed frontend origins, comma-separated
CORS_ORIGINS=http://localhost:5173,https://YOUR_FRONTEND.vercel.app
# Optional regex for preview deploys, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Email (SMTP). For local development use Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@office-booking.local

# Microsoft Graph (optional). If empty, emails go through SMTP
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=