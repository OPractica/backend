POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DATABASE


# ВАРИАНТ 1: ОБЛАКО (Supabase) — использовать, если работаете с общей базой
# DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>?ssl=require


# ВАРИАНТ 2: ЛОКАЛЬНО (через Docker / Postgres на ПК)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DATABASE

JWT_SECRET=YOUR_JWT_TOKEN
GROQ_API_KEY=YOUR_GROQ_TOKEN
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
LLM_MODEL=gemini-3.5-flash-lite
OFFICE_TIMEZONE=Europe/Chisinau

# Email (SMTP). For local development use Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@office-booking.local